# Copy this file to ".env" if you want to change it. Only VITE_ variables reach the browser,
# so NEVER put passwords or secrets here.

# Where the browser sends API requests.
#  - Set (as below): requests go straight to the backend, so the backend's CORS setting
#    (FRONTEND_URL) must match this site's origin.
#  - Empty or removed: requests go to "/api" on the Vite dev server, which proxies them to
#    http://localhost:5000 (see vite.config.js). Handy in development; no CORS involved.
VITE_API_URL=http://localhost:5000/api
