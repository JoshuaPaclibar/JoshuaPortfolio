# Optional. Only VITE_ variables reach the browser, so NEVER put passwords or secrets here.
#
# In development (npm run dev) you do NOT need this file: requests go to "/api" on the Vite
# server, which forwards them to the backend port set in backend/.env.
#
# For a production build, set the public URL of your deployed backend BEFORE `npm run build`:
# VITE_API_URL=https://your-backend-host.example.com/api
