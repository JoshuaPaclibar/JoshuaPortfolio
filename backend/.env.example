# Copy this file to ".env" and edit the values. Never commit the real .env file.

# Port the API listens on
PORT=5050

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db
# MongoDB Atlas (replace user, password and cluster; URL-encode special characters in the password):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio_db?retryWrites=true&w=majority

# Exact origin of the frontend (no trailing slash). Used for CORS.
FRONTEND_URL=http://localhost:5173

NODE_ENV=development

# ── Email delivery of contact-form messages (sent to your Gmail) ──
# 1. Turn on 2-Step Verification for your Google account.
# 2. Create an "App Password": https://myaccount.google.com/apppasswords
# 3. Paste your Gmail address and the 16-character app password below (never your normal password).
SMTP_USER=joshuapaclibar37@gmail.com
SMTP_PASS=
# Who receives the messages (defaults to SMTP_USER if left empty)
CONTACT_TO=joshuapaclibar37@gmail.com
